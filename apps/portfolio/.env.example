# APRU-SCL 2027 — environment
#
# Every value is public: a static site has no server to hide anything behind.
# Copy to .env.local for development; set the same keys in the Vercel project.
#
# Any URL left unset renders a labelled "link coming soon" affordance rather
# than a dead link, so the site builds and deploys correctly without them.

# Canonical origin. Needed for canonical URLs, sitemap, and OG image URLs.
# Set this in Vercel to https://apruscl2027.com (the code falls back to the
# same value, but set it explicitly so previews and production agree).
NEXT_PUBLIC_SITE_URL=https://apruscl2027.com

# The single register-interest form. This is the P0 conversion destination.
# BLOCKS GO-LIVE.
NEXT_PUBLIC_INTEREST_FORM_URL=

# Organising-committee inbox. No longer required: the address lives in
# content/site.json as `contactEmail`. Set this only to override it for a
# preview or a temporary redirect of enquiries.
NEXT_PUBLIC_CONTACT_EMAIL=

# Registration platform. Needed before phase P1 is switched on.
NEXT_PUBLIC_REGISTRATION_URL=

# UVENTs abstract portal. Needed before phase P2 is switched on.
NEXT_PUBLIC_UVENTS_URL=

# Plausible analytics domain. Leave empty to ship with no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Set to 1 on the portfolio deployment only. Disallows every crawler, ships an
# empty sitemap and marks every page noindex, so the client's build stays the
# one canonical APRU-SCL 2027 site. Leave unset for the client deployment.
NEXT_PUBLIC_NOINDEX=
