{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "redirects": [
    { "source": "/program", "destination": "/programme", "permanent": true },
    { "source": "/theme", "destination": "/", "permanent": true },
    { "source": "/speakers", "destination": "/highlights/keynotes", "permanent": true }
  ]
}
